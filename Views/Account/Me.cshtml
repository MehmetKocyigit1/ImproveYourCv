@model List<(Guid PublicId, DateTime CreatedAt, Roadmap? Roadmap)>
@{
    ViewData["Title"] = "Hesabım";
}

<header class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
    <div>
        <h1>Hesabım</h1>
        <p>@ViewData["Email"]</p>
    </div>
    <form asp-action="Logout" method="post"><button class="btn-ui" type="submit">Çıkış yap</button></form>
</header>

<partial name="_Message" />

<section class="section" aria-labelledby="mine-title">
    <div class="section-head">
        <h2 id="mine-title">Yol haritalarım</h2>
        <a class="btn-ui sm primary" asp-controller="Survey" asp-action="Index">Yeni yol haritası</a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="empty">Henüz yol haritan yok. Anketi doldurduğunda burada listelenir.</p>
    }
    <ul class="manage-list">
        @foreach (var (id, created, roadmap) in Model)
        {
            <li class="card-ui">
                <span class="grow">
                    <strong>@(roadmap?.RecommendedField ?? "Yol haritası")</strong>
                    <span class="meta ms-2">@created.ToLocalTime().ToString("dd.MM.yyyy")</span>
                </span>
                <a class="btn-ui sm" asp-controller="Survey" asp-action="Result" asp-route-id="@id">Aç</a>
            </li>
        }
    </ul>
</section>

<section class="section" aria-labelledby="danger-title">
    <h2 id="danger-title" class="h5">Hesabı sil</h2>
    <p class="hint">Hesabın ve profil bilgilerin (projeler, yetenekler, eğitim, deneyim, hedefler) kalıcı olarak silinir. Yol haritaların anonim olarak kalır; linkleri çalışmaya devam eder.</p>
    <form asp-action="DeleteAccount" method="post" data-confirm="Hesabın ve tüm profil bilgilerin kalıcı olarak silinsin mi? Bu işlem geri alınamaz.">
        <button class="btn-ui danger" type="submit">Hesabımı sil</button>
    </form>
</section>
