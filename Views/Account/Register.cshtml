@model ImproveYourCv.Controllers.RegisterForm
@{
    ViewData["Title"] = "Kayıt ol";
}

<div class="auth">
    <header class="page-head pb-3">
        <h1>Kayıt ol</h1>
        <p>Hesap açarsan doldurduğun anketler ve yol haritaların kaybolmaz; istediğin zaman geri dönebilirsin.</p>
    </header>
    <form asp-action="Register" method="post" class="card-ui auth-form">
        <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
        <label class="text-label mt-0" asp-for="Email">E-posta</label>
        <input class="text-input" asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>

        <label class="text-label" asp-for="Password">Şifre</label>
        <input class="text-input" asp-for="Password" autocomplete="new-password" aria-describedby="pw-hint" />
        <span class="hint mt-1" id="pw-hint">En az 8 karakter, en az bir rakam ve bir küçük harf.</span>
        <span asp-validation-for="Password" class="field-error"></span>

        <label class="text-label" asp-for="ConfirmPassword">Şifre (tekrar)</label>
        <input class="text-input" asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>

        <button class="btn-ui primary w-100 justify-content-center mt-3" type="submit">Hesap oluştur</button>
    </form>
    <p class="hint mt-3">Zaten hesabın var mı? <a asp-action="Login">Giriş yap</a></p>
</div>
