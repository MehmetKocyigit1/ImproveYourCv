@model List<Goal>
@{
    ViewData["Title"] = "Hedefler";
}

<header class="page-head">
    <h1>Hedefler</h1>
    <p>Üzerinde çalıştığım hedefler ve her birinin adımları. İlerleme, tamamlanan görevlerden hesaplanır.</p>
</header>

@if (Model.Count == 0)
{
    <p class="empty">Henüz hedef yok. Claude'a "şu alana geçmek istiyorum, bana plan çıkar" diyebilirsin.</p>
}
<div class="grid wide">
    @foreach (var g in Model)
    {
        var done = g.Tasks.Count(t => t.IsDone);
        <article class="card-ui">
            <div class="goal-top">
                <h2>@g.Title</h2>
                @if (g.TargetDate is not null)
                {
                    <span class="meta">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        @g.TargetDate.Value.ToString("dd.MM.yyyy")
                    </span>
                }
            </div>
            @if (!string.IsNullOrEmpty(g.Description)) { <p>@g.Description</p> }
            <div class="progress-ui">
                <div class="progress-track" role="progressbar" aria-label="@g.Title ilerlemesi" aria-valuenow="@g.Progress" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-fill" style="width: @g.Progress%"></div>
                </div>
                <span class="progress-label">%@g.Progress</span>
            </div>
            <p class="meta mb-2">@done / @g.Tasks.Count görev tamamlandı</p>
            <ul class="task-list">
                @foreach (var t in g.Tasks.OrderBy(t => t.IsDone).ThenBy(t => t.DueDate))
                {
                    <li class="@(t.IsDone ? "done" : "")">
                        @if (t.IsDone)
                        {
                            <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                        }
                        else
                        {
                            <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
                        }
                        <span class="title"><span class="visually-hidden">@(t.IsDone ? "Tamamlandı: " : "Açık: ")</span>@t.Title</span>
                        @if (t.DueDate is not null) { <span class="meta">@t.DueDate.Value.ToString("dd.MM")</span> }
                    </li>
                }
            </ul>
        </article>
    }
</div>
