@model (List<Project> Projects, List<Skill> Skills, int GoalCount)
@{
    ViewData["Title"] = "Portföy";
    var levels = new[] { SkillLevel.Advanced, SkillLevel.Intermediate, SkillLevel.Beginner };
    string LevelName(SkillLevel l) => l switch { SkillLevel.Advanced => "İleri", SkillLevel.Intermediate => "Orta", _ => "Başlangıç" };
}

<section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">// @Config["Profile:Title"]</p>
    <h1 id="hero-title">@Config["Profile:Name"]</h1>
    <p class="lead">@Config["Profile:Bio"]</p>
    <div class="hero-links">
        <a class="btn-ui primary" href="#projeler">
            Projelerime göz at
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </a>
        @if (!string.IsNullOrEmpty(Config["Profile:GitHubUrl"]))
        {
            <a class="btn-ui" href="@Config["Profile:GitHubUrl"]" target="_blank" rel="noopener">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                GitHub
            </a>
        }
        @if (!string.IsNullOrEmpty(Config["Profile:LinkedInUrl"]))
        {
            <a class="btn-ui" href="@Config["Profile:LinkedInUrl"]" target="_blank" rel="noopener">LinkedIn</a>
        }
        @if (!string.IsNullOrEmpty(Config["Profile:Email"]))
        {
            <a class="btn-ui" href="mailto:@Config["Profile:Email"]">E-posta</a>
        }
    </div>
    <div class="stats">
        <div class="stat"><b>@Model.Projects.Count</b><small>Proje</small></div>
        <div class="stat"><b>@Model.Skills.Count</b><small>Yetenek</small></div>
        <div class="stat"><b>@Model.GoalCount</b><small>Hedef</small></div>
    </div>
</section>

<section class="section" id="projeler" aria-labelledby="projects-title">
    <div class="section-head">
        <h2 id="projects-title">Projeler</h2>
        @if (User.IsInRole(Program.AdminRole))
        {
            <span class="d-flex gap-2">
                <a class="btn-ui sm" asp-controller="GitHub" asp-action="Index">GitHub'dan ekle</a>
                <a class="btn-ui sm" asp-controller="Manage" asp-action="Index">Yönet</a>
            </span>
        }
        else
        {
            <span class="count">@Model.Projects.Count kayıt</span>
        }
    </div>
    @if (Model.Projects.Count == 0)
    {
        <p class="empty">Henüz proje yok.</p>
    }
    <div class="grid">
        @foreach (var p in Model.Projects)
        {
            <article class="card-ui">
                <h3>@p.Title</h3>
                <p>@p.Description</p>
                <div class="tags">
                    @foreach (var t in (p.Technologies ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="tag">@t</span>
                    }
                </div>
                @if (p.RepoUrl is not null || p.DemoUrl is not null)
                {
                    <div class="card-links">
                        @if (p.RepoUrl is not null)
                        {
                            <a href="@p.RepoUrl" target="_blank" rel="noopener" aria-label="@p.Title kaynak kodu">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg>
                                Kod
                            </a>
                        }
                        @if (p.DemoUrl is not null)
                        {
                            <a href="@p.DemoUrl" target="_blank" rel="noopener" aria-label="@p.Title canlı demo">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                                Demo
                            </a>
                        }
                    </div>
                }
            </article>
        }
    </div>
</section>

<section class="section" aria-labelledby="skills-title">
    <div class="section-head">
        <h2 id="skills-title">Yetenekler</h2>
        <span class="count">@Model.Skills.Count kayıt</span>
    </div>
    @if (Model.Skills.Count == 0)
    {
        <p class="empty">Henüz yetenek yok.</p>
    }
    <div class="skill-groups">
        @foreach (var level in levels)
        {
            var group = Model.Skills.Where(s => s.Level == level).ToList();
            if (group.Count == 0) { continue; }
            <div class="skill-group card-ui">
                <h3>
                    <span class="level-dots" aria-hidden="true">
                        @for (var i = 0; i < 3; i++) { <i class="@(i <= (int)level ? "on" : "")"></i> }
                    </span>
                    @LevelName(level)
                </h3>
                <ul class="tags list-unstyled">
                    @foreach (var s in group) { <li class="tag">@s.Name</li> }
                </ul>
            </div>
        }
    </div>
</section>
